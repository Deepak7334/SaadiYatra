{
  "name": "shaadiyatra-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm --workspace=shared run build",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=shared run build && npm --workspace=backend run build && npm --workspace=frontend run build"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.1",
    "concurrently": "^9.1.0"
  }
}
